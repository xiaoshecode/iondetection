# Keep original scientific images, model weights and generated reports out of git.
.venv/
.vlm-runtime/
.venv-vlm/
.venv-vlm-train/
.venv-diffusion/
.venv-diffusion-features/
.venv-countgd/
.hf-cache/
*.gguf
.wheelhouse/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
data/**
/data.zip
!data/**/
!data/**/.gitkeep
!data/README.md
runs/**
!runs/.gitkeep
checkpoints/**
!checkpoints/.gitkeep
*.pt
*.pth

# CCD tools only: keep raw acquisitions, previews and inference artifacts local.
/CCD_2000ion/**
!/CCD_2000ion/README.md
!/CCD_2000ion/view_ion.py
!/CCD_2000ion/*.bat
!/CCD_2000ion/*.txt
!/CCD_2000ion/script/
!/CCD_2000ion/script/*.py
!/CCD_2000ion/script/*.txt
