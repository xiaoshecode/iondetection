# Keep original scientific images, model weights and unselected reports out of git.
.venv/
.vlm-runtime/
.venv-vlm/
.venv-vlm-train/
.venv-diffusion/
.venv-diffusion-features/
.venv-countgd/
.hf-cache/
*.gguf
.wheelhouse/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
data/**
/data.zip
!data/**/
!data/**/.gitkeep
!data/README.md
runs/**
!runs/.gitkeep
checkpoints/**
!checkpoints/.gitkeep
*.pt
*.pth

# CCD tools and selected reports only; keep raw acquisitions and full artifacts local.
/CCD_2000ion/**
!/CCD_2000ion/README.md
